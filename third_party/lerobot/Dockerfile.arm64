# LeRobot Docker Container for Jetson (ARM64)
# This container provides isolated LeRobot environment with Zenoh-based communication
# for training and inference commands from physical_ai_server (ROS2)
#
# Build context: physical_ai_tools/third_party/lerobot/
# Usage: docker build -f Dockerfile.arm64 -t robotis/lerobot-zenoh:arm64 .

# JetPack 6.x (L4T R36.4) base image for Jetson Orin series
# Same base image used by NVIDIA GR00T
ARG BASE_IMAGE=nvcr.io/nvidia/l4t-jetpack:r36.4.0
FROM ${BASE_IMAGE}

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Set up locale
RUN apt-get update && apt-get install -y locales \
    && locale-gen en_US en_US.UTF-8 \
    && update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*
ENV LANG=en_US.UTF-8

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    curl \
    wget \
    ca-certificates \
    cmake \
    pkg-config \
    ninja-build \
    libglib2.0-0 \
    libegl1-mesa \
    libegl1-mesa-dev \
    libgl1-mesa-glx \
    libgles2-mesa \
    ffmpeg \
    libusb-1.0-0-dev \
    libopenblas-dev \
    speech-dispatcher \
    libgeos-dev \
    portaudio19-dev \
    python3-dev \
    python3-pip \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

# Install uv (fast Python package manager)
RUN curl -LsSf https://astral.sh/uv/install.sh | sh \
    && mv /root/.local/bin/uv /usr/local/bin/uv

# Create working directory for LeRobot
WORKDIR /lerobot

# Create virtual environment using system Python (from L4T image)
RUN uv venv /lerobot/.venv --python python3

# Set virtual environment as default
ENV VIRTUAL_ENV=/lerobot/.venv
ENV PATH="/lerobot/.venv/bin:$PATH"

# Install PyTorch for Jetson from Jetson AI Lab pip index
# IMPORTANT: Use ONLY Jetson index (no --extra-index-url) to prevent uv from
# picking CPU wheels from PyPI. Jetson index includes all torch dependencies.
RUN uv pip install torch torchvision \
    --index-url https://pypi.jetson-ai-lab.io/jp6/cu126/+simple

# Install nvidia-cudss-cu12 (required by Jetson PyTorch, not included in l4t-jetpack base)
# --no-deps to avoid re-downloading cublas which is already in the base image
RUN uv pip install --no-deps nvidia-cudss-cu12
ENV LD_LIBRARY_PATH="/lerobot/.venv/lib/python3.10/site-packages/nvidia/cu12/lib:${LD_LIBRARY_PATH}"

# Copy LeRobot source and install dependencies
# Build context is third_party/lerobot/, so paths are relative to that
COPY lerobot/setup.py lerobot/pyproject.toml lerobot/README.md lerobot/MANIFEST.in ./
COPY lerobot/src/ ./src/

# Install LeRobot dependencies (training/inference only, no hardware/simulation)
# Removed: dynamixel, gamepad, hopejr, lekiwi, reachy2, kinematics (hardware)
# Removed: dev, test, video_benchmark (development)
# Removed: aloha, pusht, phone, libero, metaworld, sarm (simulation)
RUN uv pip install --no-cache ".[smolvla,xvla,hilserl,async,peft]"

# Reinstall Jetson CUDA PyTorch (lerobot deps may overwrite with CPU version from PyPI)
RUN uv pip install --reinstall torch torchvision \
    --index-url https://pypi.jetson-ai-lab.io/jp6/cu126/+simple

# Downgrade huggingface_hub to 0.35.3 for custom Hub server compatibility
RUN pip install "huggingface_hub==0.35.3"

# Copy the rest of LeRobot (configs, tests, etc.)
COPY lerobot/ ./

# Zenoh dependencies (zenoh_ros2_sdk mounted as volume at /zenoh_sdk)
# json5 required for zenoh_ros2_sdk
# IMPORTANT: eclipse-zenoh version MUST match rmw_zenoh_cpp's bundled zenoh-c version (1.6.x)
# Mismatched versions (e.g., 1.7.x vs 1.6.x) cause service call failures despite discovery working
RUN uv pip install "eclipse-zenoh>=1.6.0,<1.7.0" rosbags>=0.11.0 GitPython>=3.1.18 json5>=0.9.14 \
    && mkdir -p /zenoh_sdk

# Create application directory for Zenoh server
WORKDIR /app

# Copy entrypoint and executor scripts from build context
COPY entrypoint.sh /entrypoint.sh
COPY executor.py /app/executor.py

# Make entrypoint executable
RUN chmod +x /entrypoint.sh

# Environment variables for HuggingFace cache (mapped via volume)
ENV HF_HOME=/root/.cache/huggingface
ENV HF_LEROBOT_HOME=/root/.cache/huggingface/lerobot
ENV TORCH_HOME=/root/.cache/torch

# HuggingFace CLI aliases
RUN echo "alias huggingface-cli='hf'" >> ~/.bashrc && \
    echo "export HF_ENDPOINT=http://192.168.60.152:1000" >> ~/.bashrc

# Zenoh configuration
ENV ZENOH_ROUTER_IP=127.0.0.1
ENV ZENOH_ROUTER_PORT=7447
ENV ZENOH_SHM_ENABLED=true
ENV ZENOH_SDK_PATH=/zenoh_sdk

# Shared Memory configuration for Zenoh
ENV ZENOH_TRANSPORT_SHM_ENABLED=true

# Default working directory
WORKDIR /lerobot

# Healthcheck
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import zenoh; print('Zenoh OK')" || exit 1

# Entrypoint
ENTRYPOINT ["/entrypoint.sh"]

# Default command: start Zenoh server for receiving training/inference commands
CMD ["server"]
